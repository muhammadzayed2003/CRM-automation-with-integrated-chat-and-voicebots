    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\n\nconst firstName = body.first_name ?? '';\nconst lastName = body.last_name ?? '';\nconst email = body.email ?? '';\nconst mobile = body.mobile ?? '';\nconst landline = body.landline ?? '';\nconst country = body.country ?? '';\nconst state = body.state ?? '';\nconst serviceRequirement = body.service_requirement ?? '';\n\nconst sessionId =\n  body.session_id ??\n  body.sessionId ??\n  body.call?.id ??\n  `vapi-${Date.now()}`;\n\nconst message = JSON.stringify({\n  first_name: firstName,\n  last_name: lastName,\n  email,\n  mobile,\n  landline,\n  country,\n  state,\n  service_requirement: serviceRequirement,\n});\n\nreturn [\n  {\n    json: {\n      sessionId,\n      chatInput: message,\n      source: 'vapi',\n      first_name: firstName,\n      last_name: lastName,\n      email,\n      mobile,\n      landline,\n      country,\n      state,\n      service_requirement: serviceRequirement,\n    },\n  },\n];"
      },
